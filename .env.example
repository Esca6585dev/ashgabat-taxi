# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#   cp .env.example .env && docker compose --profile https up -d --build

# --- required ---
# openssl rand -hex 32
JWT_SECRET=
ADMIN_PHONE=+99360000000
# first admin login; change it later in the admin panel
ADMIN_PASSWORD=
# for HTTPS (Caddy); DNS must point to this server
DOMAIN=api.example.tm
PUBLIC_URL=https://api.example.tm

# --- SMS codes (SMPP); empty SMPP_IP = codes only printed in the server log ---
SMPP_IP=
SMPP_PORT=
SMPP_FROM=
SMPP_USERNAME=
# keep single quotes if the password contains $
SMPP_PASSWORD=''
SMPP_DST_FORMAT=993

# --- testing only: every SMS code equals this. Leave EMPTY for real users ---
OTP_FIXED_CODE=

# --- driver payments ---
COMMISSION_RATE=0.10
# commission | monthly
DEFAULT_DRIVER_PLAN=commission
MONTHLY_FEE=300
DRIVER_MIN_BALANCE=-50

# --- card top-up (bank contract needed); none = off ---
# rbs | none
PAYMENT_PROVIDER=none
PAYMENT_RBS_URL=https://mpi.gov.tm/payment/rest
PAYMENT_RBS_USERNAME=
PAYMENT_RBS_PASSWORD=''

# --- push notifications: put the Firebase key at ./secrets/firebase-key.json ---
# /app/secrets/firebase-key.json
FCM_CREDENTIALS_FILE=

SUPPORT_PHONE=+99312000000
