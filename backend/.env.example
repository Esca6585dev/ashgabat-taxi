# Ashgabat Taxi backend configuration
PORT=8080
APP_ENV=development
JWT_SECRET=please-change-this-secret
JWT_EXPIRY_HOURS=720

# sqlite (default, zero setup) or postgres
DB_DRIVER=sqlite
DB_DSN=taxi.db
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=taxi password=taxi dbname=taxi port=5432 sslmode=disable TimeZone=Asia/Ashgabat

ADMIN_PHONE=+99360000000
ADMIN_PASSWORD=admin12345

# SMS: log (prints code to console, returns dev_code in API) | http (generic JSON gateway)
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# Fixed OTP for testing (leave empty in production)
OTP_FIXED_CODE=1234
OTP_TTL_MIN=5

# Routing / geocoding (optional). Leave OSRM_URL empty to use straight-line estimate x1.3
OSRM_URL=
NOMINATIM_URL=https://nominatim.openstreetmap.org

DISPATCH_RADIUS_KM=3
DISPATCH_MAX_RADIUS_KM=12
DISPATCH_TIMEOUT_SEC=300
DISPATCH_BATCH=10
DRIVER_OFFLINE_SEC=120

COMMISSION_RATE=0.10
CURRENCY=TMT
CITY_LAT=37.9601
CITY_LNG=58.3261
SUPPORT_PHONE=+99312000000

ADMIN_DIR=./web/admin
SITE_DIR=../website
