# Ashgabat Taxi backend configuration
PORT=8080
APP_ENV=development
JWT_SECRET=please-change-this-secret
JWT_EXPIRY_HOURS=720

# sqlite (default, zero setup) or postgres
DB_DRIVER=sqlite
DB_DSN=taxi.db
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=taxi password=taxi dbname=taxi port=5432 sslmode=disable TimeZone=Asia/Ashgabat

ADMIN_PHONE=+99360000000
ADMIN_PASSWORD=admin12345

# SMS: log (prints code to console, returns dev_code in API) | http (generic JSON gateway) | smpp
# Empty SMS_PROVIDER => smpp when SMPP_IP is set, otherwise log.
SMS_PROVIDER=log
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# SMPP 3.4 operator connection (SMS_PROVIDER=smpp). Put the real values only in .env, never in git.
# Wrap a password that contains $ in single quotes: SMPP_PASSWORD='pa$$word'
SMPP_IP=
SMPP_PORT=
SMPP_FROM=
SMPP_USERNAME=
SMPP_PASSWORD=
# Recipient number format for the SMSC: 993 (99365123456) | plus (+99365123456) | local (65123456) | 8 (865123456)
SMPP_DST_FORMAT=993
# Optional address flags if the operator asks for them (TON/NPI). Defaults: source 0/0, destination 1/1.
# SMPP_SRC_TON=0
# SMPP_SRC_NPI=0
# SMPP_DST_TON=1
# SMPP_DST_NPI=1
# SMPP_SYSTEM_TYPE=
# Fixed OTP for testing (leave empty in production)
OTP_FIXED_CODE=1234
OTP_TTL_MIN=5

# Push notifications (Firebase Cloud Messaging). Service-account key from
# Firebase console → Project settings → Service accounts → Generate new private key.
# Empty => push disabled. Never commit the key file.
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_JSON=   # alternatively the whole JSON in one line

# Routing / geocoding (optional). Leave OSRM_URL empty to use straight-line estimate x1.3
OSRM_URL=
NOMINATIM_URL=https://nominatim.openstreetmap.org

DISPATCH_RADIUS_KM=3
DISPATCH_MAX_RADIUS_KM=12
DISPATCH_TIMEOUT_SEC=300
DISPATCH_BATCH=10
DRIVER_OFFLINE_SEC=120

COMMISSION_RATE=0.10
CURRENCY=TMT
CITY_LAT=37.9601
CITY_LNG=58.3261
SUPPORT_PHONE=+99312000000

ADMIN_DIR=./web/admin
SITE_DIR=../website
